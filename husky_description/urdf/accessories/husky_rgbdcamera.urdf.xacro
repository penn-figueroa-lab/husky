<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="front_rgbd_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.09 0.03"/>
      </geometry>
      <material name="Black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.09 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="0.0001" ixy="0.0" ixz="0.0"
        iyy="0.0001" iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <link name="front_rgbd_optical_frame"></link>

  <joint name="front_rgbd_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_rgbd_frame"/>
    <origin xyz="0.0 0.0 0.45" rpy="0 0 0"/>
  </joint>

  <joint name="front_rgbd_optical_joint" type="fixed">
    <parent link="front_rgbd_frame"/>
    <child link="front_rgbd_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <gazebo reference="front_rgbd_frame">
    <sensor name="camera" type="depth">
      <pose> 0 0 0 0 0 0 </pose>
      <update_rate>10</update_rate>

      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
      </camera>

      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>front_rgbd_optical_frame</frame_name>
      </plugin>

    </sensor>
  </gazebo>

</robot>